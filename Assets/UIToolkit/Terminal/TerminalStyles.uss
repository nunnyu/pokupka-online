/* ── Terminal overlay ─────────────────────────────────────────────────────── */

.terminal-overlay {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    align-items: center;
    justify-content: center;
    display: none;
    /* Dim the world slightly behind the terminal */
    background-color: rgba(0, 0, 0, 0.35);
}

/* ── Terminal panel ───────────────────────────────────────────────────────── */

.terminal-panel {
    width: 82%;
    height: 76%;
    background-color: rgba(4, 8, 4, 0.93);
    border-width: 1px;
    border-color: rgb(0, 200, 50);
    padding: 10px 14px 10px 14px;
    flex-direction: column;
}

/* ── Output scroll area ───────────────────────────────────────────────────── */

.terminal-output {
    flex-grow: 1;
    overflow: hidden;
}

.terminal-output > .unity-scroll-view__content-container {
    flex-direction: column;
    align-items: flex-start;
}

/* ── Individual output lines ─────────────────────────────────────────────── */

.terminal-line {
    color: rgb(0, 220, 60);
    font-size: 15px;
    white-space: normal;
    -unity-font-style: normal;
    margin: 0;
    padding: 0;
}

.terminal-line.error {
    color: rgb(255, 70, 70);
}

/* ── Input row ────────────────────────────────────────────────────────────── */

.terminal-input-row {
    flex-direction: row;
    align-items: center;
    margin-top: 4px;
    border-top-width: 1px;
    border-top-color: rgba(0, 200, 50, 0.3);
    padding-top: 6px;
}

.terminal-prompt {
    color: rgb(0, 220, 60);
    font-size: 15px;
    -unity-font-style: bold;
    margin: 0;
    padding: 0;
    flex-shrink: 0;
}

.terminal-input {
    flex-grow: 1;
    color: rgb(0, 220, 60);
    font-size: 15px;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    margin: 0;
    padding: 0;
    -unity-font-style: normal;
}

/* Hide the text field's inner border/background */
.terminal-input > .unity-base-field__input {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    padding: 0;
    color: rgb(0, 220, 60);
}

.terminal-input > .unity-base-text-field__input {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    padding: 0;
    color: rgb(0, 220, 60);
}
