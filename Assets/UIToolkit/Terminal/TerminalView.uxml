<ui:UXML xmlns:ui="UnityEngine.UIElements"
         xsi="http://www.w3.org/2001/XMLSchema-instance"
         editor-extension-mode="False">
    <Style src="project://database/Assets/UIToolkit/Terminal/TerminalStyles.uss" />

    <!-- Full-screen backdrop, hidden by default -->
    <ui:VisualElement name="terminal-overlay" class="terminal-overlay">

        <ui:VisualElement name="terminal-panel" class="terminal-panel">

            <!-- Scrollable output history -->
            <ui:ScrollView name="output-scroll" class="terminal-output"
                           vertical-scroller-visibility="Hidden"
                           horizontal-scroller-visibility="Hidden" />

            <!-- Input row: prompt label + text field -->
            <ui:VisualElement name="input-row" class="terminal-input-row">
                <ui:Label name="prompt-label" text="$ " class="terminal-prompt" />
                <ui:TextField name="input-field" class="terminal-input"
                              multiline="false"
                              max-length="200" />
            </ui:VisualElement>

        </ui:VisualElement>

    </ui:VisualElement>
</ui:UXML>
