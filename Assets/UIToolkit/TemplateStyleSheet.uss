/* ── pkill -9 — PS1 Main Menu Style ──────────────────────────────────────── */

* {
    -unity-font-style: bold;
}

/* ── Canvas (full-screen background) ─────────────────────────────────────── */

.canvas {
    align-items: center;
    justify-content: center;
    align-self: auto;
    flex-grow: 1;
    /* Near-black with a cold blue tint, PS1 boot-screen energy */
    background-color: rgb(6, 6, 16);
}

/* ── Title ────────────────────────────────────────────────────────────────── */

.label {
    -unity-text-align: upper-center;
    font-size: 64px;
    color: rgb(240, 240, 255);
    /* Hard pixel shadow — no blur, PS1 style */
    text-shadow: 3px 3px 0 rgb(0, 0, 30);
}

.title {
    font-size: 120px;
    margin-bottom: 72px;
    color: rgb(255, 255, 255);
    text-shadow: 4px 4px 0 rgb(0, 0, 60);
    letter-spacing: 2px;
}

/* ── Buttons ──────────────────────────────────────────────────────────────── */

.button {
    font-size: 28px;
    width: 320px;
    height: 60px;
    /* Flat dark panel, no rounded corners — sharp PS1 UI */
    background-color: rgb(10, 12, 30);
    color: rgb(200, 200, 220);
    border-radius: 0;
    border-width: 2px;
    border-color: rgb(50, 60, 140);
    text-shadow: 2px 2px 0 rgb(0, 0, 20);
    margin-top: 6px;
    margin-bottom: 6px;
    transition-property: background-color, border-color, color;
    transition-duration: 0.04s;
}

.button:hover {
    background-color: rgb(20, 24, 60);
    border-color: rgb(100, 120, 255);
    color: rgb(255, 255, 255);
}

.button:active {
    background-color: rgb(5, 6, 20);
    border-color: rgb(40, 50, 120);
    color: rgb(160, 160, 180);
}

.button:disabled {
    background-color: rgb(8, 8, 20);
    border-color: rgb(30, 30, 60);
    color: rgb(80, 80, 100);
}

/* PLAY gets a brighter accent border to stand out */
.button--play {
    border-color: rgb(80, 100, 220);
    color: rgb(220, 230, 255);
}

.button--play:hover {
    background-color: rgb(25, 30, 80);
    border-color: rgb(140, 160, 255);
    color: rgb(255, 255, 255);
}

/* ── Sublabel ─────────────────────────────────────────────────────────────── */

.sublabel {
    font-size: 28px;
    margin-bottom: 48px;
    color: rgb(140, 140, 160);
}
